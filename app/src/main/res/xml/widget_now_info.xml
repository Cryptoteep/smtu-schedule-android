<?xml version="1.0" encoding="utf-8"?>
<!-- targetCell*/previewLayout читает только Android 12+; ниже их молча
     пропускают и берут minWidth/minHeight и initialLayout — так и задумано -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UnusedAttribute"
    android:minWidth="180dp"
    android:minHeight="40dp"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_now"
    android:previewLayout="@layout/widget_now"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_now_desc" />
