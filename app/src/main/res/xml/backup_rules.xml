<?xml version="1.0" encoding="utf-8"?>
<!-- Cloud backup / device transfer: the saved group and the schedule cache are
     small and safe to carry over to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" />
        <include domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" />
        <include domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
